    {
      "name": "sources",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"sources\" (\"updated_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), \"deleted_at\" INTEGER NULL, \"id\" TEXT NOT NULL, \"kind\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"config_json\" TEXT NOT NULL, \"enabled\" INTEGER NOT NULL DEFAULT 1 CHECK (enabled IN (0, 1)), \"last_refresh\" INTEGER NULL, \"refresh_policy\" TEXT NOT NULL DEFAULT 'manual', PRIMARY KEY(id));"
        }
      ]
    },
    {
      "name": "categories",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"categories\" (\"id\" TEXT NOT NULL, \"source_id\" TEXT NOT NULL, \"content_type\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"sort_order\" INTEGER NOT NULL DEFAULT 0, PRIMARY KEY(id));"
        }
      ]
    },
    {
      "name": "channels",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"channels\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"source_id\" TEXT NOT NULL, \"ref_key\" TEXT NOT NULL, \"category_id\" TEXT NULL, \"content_type\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"url\" TEXT NOT NULL, \"tvg_id\" TEXT NULL, \"logo\" TEXT NULL, \"metadata_json\" TEXT NOT NULL DEFAULT '{}', UNIQUE(source_id, ref_key));"
        }
      ]
    },
    {
      "name": "epg_programmes",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"epg_programmes\" (\"tvg_id\" TEXT NOT NULL, \"start\" INTEGER NOT NULL, \"stop\" INTEGER NOT NULL, \"title\" TEXT NOT NULL, \"description\" TEXT NULL, PRIMARY KEY(tvg_id, start));"
        }
      ]
    },
    {
      "name": "favorites",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"favorites\" (\"updated_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), \"deleted_at\" INTEGER NULL, \"source_id\" TEXT NOT NULL, \"ref_key\" TEXT NOT NULL, \"sort_order\" INTEGER NOT NULL DEFAULT 0, PRIMARY KEY(source_id, ref_key));"
        }
      ]
    },
    {
      "name": "watch_state",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"watch_state\" (\"updated_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), \"deleted_at\" INTEGER NULL, \"source_id\" TEXT NOT NULL, \"ref_key\" TEXT NOT NULL, \"position_ms\" INTEGER NOT NULL DEFAULT 0, \"duration_ms\" INTEGER NOT NULL DEFAULT 0, PRIMARY KEY(source_id, ref_key));"
        }
      ]
    },
    {
      "name": "paired_devices",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"paired_devices\" (\"updated_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), \"deleted_at\" INTEGER NULL, \"device_id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"platform\" TEXT NOT NULL, \"public_key\" TEXT NOT NULL, \"last_seen\" INTEGER NOT NULL, \"auto_sync_enabled\" INTEGER NOT NULL DEFAULT 0 CHECK (auto_sync_enabled IN (0, 1)), PRIMARY KEY(device_id));"
        }
      ]
    },
