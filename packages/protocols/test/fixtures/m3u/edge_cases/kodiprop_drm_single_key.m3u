#EXTM3U
# Fuente: 4gray/iptvnator issue #656 (https://github.com/4gray/iptvnator/issues/656)
# "iptvnator does not play encrypted channels" — ejemplo de canal DRM clearkey
# con una sola clave, tal cual aparece en el issue (dominio sustituido por
# example.com; el resto es literal).
#EXTINF:-1 tvg-logo="", name1
#EXTVLCOPT:http-user-agent=Android
#KODIPROP:inputstreamaddon=inputstream.adaptive
#KODIPROP:inputstream.adaptive.manifest_type=dash
#KODIPROP:inputstream.adaptive.license_type=clearkey
#KODIPROP:inputstream.adaptive.license_key=a18b6aa739be4c0b114605fcfb5d6b68:b41c3a6f7511b2e3a828d9580124c89d
https://example.com/dash/index.mpd
